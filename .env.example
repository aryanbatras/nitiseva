# ---------------------------------------------------------------------------
# NitiSeva — environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or real credentials.
# ---------------------------------------------------------------------------

# Public origin of the deployed site. Used for metadata, Cashfree return URLs,
# webhooks, the sitemap and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cashfree payment gateway — server credentials.
# Dashboard: Developers → API keys. Use the sandbox keys while testing.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# "sandbox" (default) or "production". This controls the server API base URL.
CASHFREE_ENV=sandbox

# Must match CASHFREE_ENV. This tells the browser which Cashfree checkout
# environment to load.
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Secret used to verify the x-webhook-signature header.
# If omitted, the webhook route falls back to CASHFREE_CLIENT_SECRET.
# Dashboard: Developers → Webhooks.
CASHFREE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cashfree webhook URL to register in the dashboard:
#   {NEXT_PUBLIC_SITE_URL}/api/cashfree/webhook
#
# Events: PAYMENT_SUCCESS_WEBHOOK and PAYMENT_FAILED_WEBHOOK.
# The signature is base64(HMAC-SHA256(timestamp + rawBody, secret)).
# ---------------------------------------------------------------------------
